# 只填地址与口令；本文件**不要**提交（deploy/worker/*.env 已在 .gitignore）
# 复制为 worker.env 后填写。口令请用你自己的值，勿写进任何文档或提交记录。

# --- Django ---
DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,host.docker.internal

# --- PostgreSQL（宿主编排的容器；容器内用 host.docker.internal + 宿主端口）---
DB_ENGINE=postgres
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=55432
POSTGRES_DB=replace-me
POSTGRES_USER=replace-me
POSTGRES_PASSWORD=replace-me

# --- Redis：**必须用与业务不同的 DB 号**（示例用 15）---
# 业务 DB0 里的历史消息不会被本 worker 触碰
KB_CELERY_BROKER_URL=redis://host.docker.internal:56379/15
KB_CELERY_RESULT_BACKEND=redis://host.docker.internal:56379/15

# --- 专用队列（不要改成业务默认队列名）---
KB_CELERY_QUEUE=kb_worker_v2

# --- Qdrant：阶段 2 完成后指向新的 ext4 实例；未完成前仍指旧端口 ---
KB_QDRANT_URL=http://host.docker.internal:56333
KB_QDRANT_TIMEOUT=10

# --- 模型服务（只读调用；**不要**在这里启停 AS711 的任何服务）---
KB_MODEL_CALLS_DISABLED=0
