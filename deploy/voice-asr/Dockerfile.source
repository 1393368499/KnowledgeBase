# Optional offline source update. RUNTIME_IMAGE must be an explicitly selected
# local image; the build refuses it unless every locked dependency matches.
ARG RUNTIME_IMAGE=python:3.13-slim
FROM ${RUNTIME_IMAGE}
COPY deploy/voice-asr/requirements.lock /tmp/requirements.lock
RUN python -c "import importlib.metadata as m; from pathlib import Path; pairs=[line.strip().split('==') for line in Path('/tmp/requirements.lock').read_text().splitlines() if line.strip()]; assert all(m.version(name)==version for name,version in pairs), 'ASR runtime does not match requirements.lock'" \
 && python -m pip check
WORKDIR /srv
COPY deploy/voice-asr/server.py /srv/server.py
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8090", "--workers", "1"]
