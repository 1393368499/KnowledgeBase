# 知识库系统 · 环境变量样例
#
# 复制成 .env 再按需改：cp .env.example .env
#   * .env 不进仓库（见 .gitignore），口令只放这里，代码和文档里都不出现真实口令；
#   * 这里的值全是**本地开发默认值**，和 docker-compose.yml 的默认值对齐，
#     照抄即可连上本机的项目隔离基础设施。
#
# 起基础设施：docker compose up -d

# ---------------------------------------------------------------- Django ----
# 宿主开发用 1；**容器部署不看这个值**（见文件末「容器部署须知」）。
DJANGO_DEBUG=1
# 生产必须换掉，且不要提交到仓库
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
DJANGO_TIME_ZONE=Asia/Shanghai
DJANGO_LOG_LEVEL=INFO

# -------------------------------------------------------------- 数据库 ----
# sqlite（应用默认，宿主开发/测试）或 postgres
# ⚠️ 容器里这一行**不生效**：deploy/docker-compose.unified.yml 用
#    `DB_ENGINE: "${KB_DB_ENGINE:-postgres}"` 钉死了 postgres（否则照抄本样例会让容器
#    退化到 SQLite：web 可写 / worker 只读 / beat 锁冲突，postgres 白跑）。
DB_ENGINE=sqlite
# 下面这组对应 docker-compose.yml 的 postgres 服务（宿主机端口 55432）
KB_PG_HOST=127.0.0.1
KB_PG_PORT=55432
KB_PG_DB=kb
KB_PG_USER=kb
KB_PG_PASSWORD=kb_local_dev_only

# ---------------------------------------------------------- 缓存 / 队列 ----
# 1 = 用真实 Redis；0 = 用进程内 LocMemCache（单测默认）
USE_REDIS_CACHE=0
KB_REDIS_URL=redis://127.0.0.1:56379/1
# Celery **必须**用专用 DB14，绝不能用 DB0：
# DB0 是共享生产业务队列（那里有别人的业务消息，只读也不能碰），
# 宿主上跑 pytest/验收脚本时如果 broker 指向 DB0，任务会直接投进业务库。
# 容器里由 deploy/docker-compose.unified.yml 的 environment 覆盖为 redis:6379/14。
CELERY_BROKER_URL=redis://127.0.0.1:56379/14
CELERY_RESULT_BACKEND=redis://127.0.0.1:56379/14
# 生产默认必须是 0：eager 会让 apply_async 在**上传请求里**同步执行，
# 等于没有队列（远端模型掉线时请求会被长时间挂住）。
# 本地无 worker 想同步验收，请用 KB_UPLOAD_PROCESS_MODE=inline，而不是打开 eager。
CELERY_TASK_ALWAYS_EAGER=0
# broker 发布超时/重试：掉线时快速失败，不阻塞请求
CELERY_BROKER_SOCKET_TIMEOUT=2
CELERY_BROKER_CONNECT_TIMEOUT=2
CELERY_BROKER_MAX_RETRIES=1

# ---------------------------------------------------- 上传处理模式 ----
# inline = 请求内同步处理（本地最省事）
# queue  = 落盘后立刻 202 + task_id，由 worker 处理
# auto   = 能派发就派发，否则如实返回"待处理"（默认）
KB_UPLOAD_PROCESS_MODE=auto
# 处理租约时长（秒）：长任务会续租；过期后可被其它 worker 接管
KB_PROCESS_LEASE_SECONDS=900

# ------------------------------------------------ 外部服务熔断/重试 ----
KB_SERVICE_FAILURE_THRESHOLD=3
KB_SERVICE_COOLDOWN_SECONDS=60
KB_EMBED_RETRIES=2
KB_OCR_MAX_PAGES=200
KB_OCR_MAX_TOKENS=4096
KB_OCR_REPETITION_PENALTY=1.1
KB_OCR_MAX_CONCURRENCY=2
KB_OCR_SLOT_WAIT_SECONDS=300

# ------------------------------------- 离线测试适配器（默认关闭！） ----
# 只有显式设为 offline 才启用确定性假向量，且只允许写 __offline_test collection。
# 生产/验收真实链路时必须留空，否则得到的是假向量结果。
KB_TEST_ADAPTER=

# ------------------------------- 确认/执行窗口与负载测试（安全相关） ----
# ARMED（确认完成、待执行）的有效秒数。超过就要求**重新提案**，不自动续期——
# 否则"三次确认"会退化成"某一天确认过"，用过期的确认执行已变化的目标。
# 默认与 KB_ACTION_TICKET_TTL_SECONDS 一致，避免"凭证还有效但操作已过期"的错位。
KB_ARMED_TTL_SECONDS=900

# 负载测试环境标识。**正式部署必须留空/0**：压测脚本会 fail-closed 地检查
# 目标服务是否显式声明 load_test_mode=True，正式服务默认 False → 脚本拒绝发压。
# 完整用法见 config/loadtest_settings.py 与 scripts/loadtest_env.py。
KB_LOAD_TEST_MODE=0
KB_LOAD_TEST_LABEL=
# 禁止把处理任务派发到队列（压测实例用；正式环境必须为 0）
KB_DISPATCH_DISABLED=0
# 注意：负载测试**不要**用这个 .env，请用 config.loadtest_settings（它会在导入后
# 强制改写库名/前缀/Redis DB/模型开关，使这里的值无法把它盖回业务）。

# ------------------------------------------- 离线模式（无模型）开关 ----
# AS711 未就绪时设为 1：所有模型外呼（嵌入/重排/OCR）**立刻**以"服务未启用"
# 失败，界面不卡超时且绝不产生真实请求；语义检索会如实标注不可用，
# 关键字检索照常工作。与 KB_TEST_ADAPTER 不同：它**什么都不写**，不会污染索引。
# 模型服务恢复后改回 0。
KB_MODEL_CALLS_DISABLED=0
# 是否启用稠密（语义）检索；设 0 时检索直接走关键字
KB_SEARCH_DENSE_ENABLED=1
# 检索用嵌入超时（短请求，别设大）；入库超时可单独放宽
KB_EMBED_TIMEOUT_SECONDS=10
KB_EMBED_INDEX_TIMEOUT_SECONDS=60
KB_RERANK_TIMEOUT_SECONDS=15

# ------------------------------------------------------------ 向量库 ----
# 对应 docker-compose.yml 的 qdrant 服务（宿主机端口 56333）
KB_QDRANT_URL=http://127.0.0.1:56333
KB_QDRANT_API_KEY=
KB_QDRANT_TIMEOUT=10

# ------------------------------------------------------- 运行期目录 ----
# 默认就是项目根下的 vector_data / db / media，一般不用改
# VECTOR_DATA_DIR=D:/AProjectScript/KnowledgeBase/vector_data
# DB_DIR=D:/AProjectScript/KnowledgeBase/db
# MEDIA_ROOT_DIR=D:/AProjectScript/KnowledgeBase/media

# ------------------------------------------------------ 治理与上传 ----
KB_ACTION_TICKET_TTL_SECONDS=180
KB_DELETE_NAME_ATTEMPTS=3
KB_UPLOAD_MAX_BYTES=209715200
# 图片格式不能漏：扫描件（.jpg/.png/…）是 OCR 入口，解析器认、白名单也必须认
KB_ALLOWED_UPLOAD_EXT=.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.md,.txt,.csv,.png,.jpg,.jpeg,.webp,.bmp,.tif,.tiff

# ------------------------------------------------- AS711 模型服务 ----
# 这四个是本项目实测确认可用的端点；口令走 KB_MODEL_API_KEY，绝不写进仓库
KB_MODEL_API_KEY=
AS711_LLM_BASE_URL=http://172.16.100.114:10001/v1
AS711_LLM_MODEL=Qwen3.6-35B-A3B-FP8
AS711_EMBED_BASE_URL=http://172.16.100.114:8000/v1
# 当前已部署并实测可用的模型：bge-large-zh-v1.5，实测输出 1024 维
AS711_EMBED_MODEL=bge-large-zh-v1.5
AS711_EMBED_DIM=1024
AS711_RERANK_BASE_URL=http://172.16.100.114:8002/v1
AS711_RERANK_MODEL=bge-reranker-large
AS711_OCR_BASE_URL=http://172.16.100.114:8003/v1
AS711_OCR_MODEL=PaddleOCR-VL-1.5
AS711_OCR_MAX_NUM_SEQS=16

# ---- 采样口径：默认统一 greedy，别随手关 ----
# AS711 的 vLLM-TPU 引擎在同一个 batch 里混到 greedy 与 random 请求时会整体崩
# （aten::where.self_out 未实现 → EngineCore 退出，见 config/settings.py 同名说明）。
# 本系统因此一律发 greedy；等厂家镜像修好再恢复随机采样：KB_LLM_GREEDY_ONLY=0
KB_LLM_GREEDY_ONLY=1
KB_LLM_TEMPERATURE=0.2
# 一次提问里模型最多连续发起几轮工具调用（只读检索会自动执行并回填结果）。
# 上限之外还有"关掉工具再问一次"的兜底，保证最终一定给出正文回答。
KB_LLM_MAX_TOOL_ROUNDS=3

# ---------------------------------------------------- 容器部署须知 ----
# 用 deploy/docker-compose.unified.yml（根 docker-compose.yml 已 include 它）时，
# 下面这些是**插值变量**，要写在**仓库根的 .env** 里（用 `-f deploy/...` 时必须加
# `--env-file .env`，否则根 .env 不参与 `${}` 插值，口令会静默退回默认值）：
#
# KB_PG_PASSWORD=<真实口令>      # 不设会用 kb_local_dev_only，与应用侧不一致 → 认证失败
# KB_PG_HOST_PORT=55432          # 宿主映射端口
# KB_PG_USER=kb / KB_PG_DB=kb    # 与卷里已有的库/角色保持一致（别改）
# KB_DB_ENGINE=postgres          # compose 里 DB_ENGINE 的取值来源（默认已是 postgres）
# KB_DJANGO_DEBUG=0              # 生产口径；宿主开发想开调试页设 1
# KB_ALLOWED_HOSTS=127.0.0.1,localhost,web,<服务器IP或域名>
# KB_WEB_BIND=0.0.0.0            # 默认 127.0.0.1（只给本机）；给内网访问才改 0.0.0.0
# KB_WEB_HOST_PORT=8800          # 宿主端口；Windows 上**不要用 8000**（WinNAT 预留段）
# KB_BASE_IMAGE=kb-worker:local-build   # 换机器时先 `bash deploy/build-app.sh` 产出该基座
#
# 首次部署顺序见 docs/deployment-and-operations.md §1；核心是：
#   docker volume create knowledgebase-pgdata knowledgebase-redisdata
#   bash deploy/build-app.sh && docker compose up -d
#   docker compose exec web python manage.py kbcreateuser       # 管理员账号没有被自动创建
